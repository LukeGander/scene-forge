---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign in">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-xl border border-slate-400/20 bg-slate-900/60 p-8 text-white">
      <h1
        class="mb-6 bg-gradient-to-r from-slate-300 to-amber-300 bg-clip-text text-center text-2xl font-bold text-transparent"
      >
        Sign in
      </h1>
      <SignInForm serverError={error} client:load />
      <p class="mt-4 text-center text-sm text-stone-300/70">
        Don't have an account? <a href="/auth/signup" class="text-amber-400 hover:underline">Sign up</a>
      </p>
    </div>
  </div>
</Layout>
