---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import ForgeSceneButton from "@/components/scenes/ForgeSceneButton";
import NoteEditor from "@/components/scenes/NoteEditor";
import { createClient } from "@/lib/supabase";
import { isCardStale } from "@/lib/forge-scene/staleness";
import { resolveSceneCardLookup, type SceneCardRow } from "@/lib/forge-scene/card-lookup";
import type { SceneCardRecord } from "@/lib/forge-scene/types";

const { id } = Astro.params;
const { user } = Astro.locals;

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase || !user) {
  return Astro.redirect("/auth/signin");
}

if (!id) {
  return new Response("Not found", { status: 404 });
}

const { data: scene, error } = await supabase
  .from("scenes")
  .select("id, title, note, updated_at")
  .eq("id", id)
  .eq("user_id", user.id)
  .single<{ id: string; title: string; note: string; updated_at: string }>();

// no-unnecessary-condition misreads Supabase's conditional response-union type here;
// `scene`/`error` are genuinely nullable at runtime (verified via `astro check`).
// eslint-disable-next-line @typescript-eslint/no-unnecessary-condition
if (error || !scene) {
  return new Response("Not found", { status: 404 });
}

const { data: sceneCardData, error: sceneCardError } = await supabase
  .from("scene_cards")
  .select(
    "player_goal, obstacle, characters, interactive_element, required_assets, design_risks, status, creator_notes, generation_source, generated_at",
  )
  .eq("scene_id", scene.id)
  .eq("user_id", user.id)
  .maybeSingle<SceneCardRow>();

const sceneCard = resolveSceneCardLookup(sceneCardData, sceneCardError);

const initialRecord: SceneCardRecord | null = sceneCard
  ? {
      playerGoal: sceneCard.player_goal,
      obstacle: sceneCard.obstacle,
      characters: sceneCard.characters,
      interactiveElement: sceneCard.interactive_element,
      requiredAssets: sceneCard.required_assets,
      designRisks: sceneCard.design_risks,
      status: sceneCard.status,
      notes: sceneCard.creator_notes,
    }
  : null;
const initialSource = sceneCard?.generation_source ?? null;
const initialIsStale = sceneCard ? isCardStale(scene.updated_at, sceneCard.generated_at) : false;
---

<Layout title={scene.title}>
  <div class="bg-cosmic min-h-screen p-4">
    <Topbar />
    <div
      class="mx-auto max-w-2xl space-y-4 rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl"
    >
      <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        {scene.title}
      </h1>
      <NoteEditor sceneId={scene.id} initialNote={scene.note} client:load />
      <ForgeSceneButton
        sceneId={scene.id}
        initialRecord={initialRecord}
        initialSource={initialSource}
        initialIsStale={initialIsStale}
        client:load
      />
    </div>
  </div>
</Layout>
